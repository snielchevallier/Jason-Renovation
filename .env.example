# -----------------------------------------------------------------------------
# Variables d'environnement (developpement local)
#
# Copier ce fichier en ".env" a la racine du projet :
#     cp .env.example .env        (Git Bash / Linux / macOS)
#     copy .env.example .env      (PowerShell / CMD)
#
# Ces valeurs sont des valeurs de DEVELOPPEMENT. Ce ne sont pas des secrets.
# En production, les secrets sont fournis par l'environnement du serveur,
# jamais par Git.
# -----------------------------------------------------------------------------

# PostgreSQL (service "database")
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Backend : cle interne Symfony. Valeur de dev quelconque (non sensible).
# En production, definir une vraie valeur aleatoire via l'environnement du serveur.
APP_SECRET=dev_seulement_a_changer_en_production

# Backend : passphrase de la cle privee JWT (Lexik). Valeur de dev.
# Apres "cp .env.example .env", generer les cles :
#   docker compose exec backend php bin/console lexik:jwt:generate-keypair
JWT_PASSPHRASE=dev_seulement_a_changer_en_production

# Ports exposes sur la machine hote.
# A changer si plusieurs projets bases sur ce template tournent en meme temps.
# L'URL de l'API vue du navigateur (NEXT_PUBLIC_API_URL) en decoule
# automatiquement dans compose.yaml : http://localhost:<BACKEND_PORT>
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
