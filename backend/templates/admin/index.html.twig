{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
<main style="max-width: 40rem; margin: 4rem auto; font-family: system-ui, sans-serif;">
    <h1 style="font-size: 1.25rem;">Administration</h1>
    <p>Connecte en tant que <strong>{{ app.user.userIdentifier }}</strong> ({{ app.user.roles|join(', ') }}).</p>
    <p>Le back-office (EasyAdmin) sera monte ici en Phase 3.</p>
    <p><a href="{{ path('app_logout') }}">Se deconnecter</a></p>
</main>
{% endblock %}
