{% extends 'base.html.twig' %}

{% block title %}Connexion — Administration{% endblock %}

{% block body %}
<main style="max-width: 22rem; margin: 4rem auto; font-family: system-ui, sans-serif;">
    <h1 style="font-size: 1.25rem;">Administration</h1>

    <form method="post">
        {% if error %}
            <p style="color: #b00020;">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
        {% endif %}

        {% if app.user %}
            <p>
                Connecte en tant que {{ app.user.userIdentifier }}.
                <a href="{{ path('app_logout') }}">Se deconnecter</a>
            </p>
        {% endif %}

        <label for="username">Email</label>
        <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus
               style="display:block; width:100%; margin:.25rem 0 .75rem;">

        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="_password" autocomplete="current-password" required
               style="display:block; width:100%; margin:.25rem 0 .75rem;">

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <button type="submit" style="margin-top:.5rem;">Se connecter</button>
    </form>
</main>
{% endblock %}
